<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>Katalogschaerfung: Cosmic Clarity mit Katalogpruefung fuer PixInsight.</p>
   </description>
   <platform os="all" arch="noarch" version="1.8.9:1.9.99">
      <package fileName="20261114-Katalogschaerfung.zip" sha1="545d3405476180a45b7dbac0aaabdef01070c346" type="script" releaseDate="20261114">
         <title>Katalogschaerfung 1.0</title>
         <description>
            <p>Schaerft lineare, astrometrisch geloeste Bilder mit Cosmic Clarity (SetiAstroSuite Pro).
            Das Sternmodell wirkt nur dort, wo Gaia DR3 oder der Legacy Survey einen Stern kennen;
            Hintergrundgalaxien werden nicht zu Sternen. Menue: Script &gt; Utilities &gt; Katalogschaerfung.</p>
            <p>Voraussetzungen: SetiAstroSuite Pro und Python mit astropy, scipy, pyvo, astroquery, truststore.</p>
         </description>
      </package>
   </platform>
</xri>
